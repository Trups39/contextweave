# Firebase web app config (Firebase console → Project settings → Your apps).
# These are public identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Cloud model for the optional review step. Confirm it is enabled for your
# Firebase AI Logic backend before demoing.
VITE_CLOUD_MODEL=gemini-2.5-flash

# Public demo page (Firebase Hosting), shown in Diagnostics.
VITE_DEMO_URL=https://YOUR-PROJECT.web.app/docs/

# Do NOT put an App Check debug token here: it would be bundled into the
# extension. Paste it into the side panel's Diagnostics section instead.
